# LLM API配置
LLM_API_KEY=your_api_key_here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
# API风格: openai 或 anthropic（MiniMax等兼容Anthropic格式的服务使用anthropic）
LLM_API_STYLE=openai

# ===== 数据源API配置（可选，未配置时降级为爬虫模式） =====
# 配置API后支持大规模采集（10万+），未配置时使用Playwright爬虫（上限约1000条）

# Reddit API（https://www.reddit.com/prefs/apps 创建应用获取）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendPulse/1.0

# YouTube Data API v3（https://console.cloud.google.com/apis 启用YouTube Data API获取）
YOUTUBE_API_KEY=

# Twitter/X API v2（https://developer.x.com 申请Basic以上级别获取）
TWITTER_BEARER_TOKEN=

# Twitter/X twscrape 账号池（格式: username:password:email:email_password，多账号用分号分隔）
# 示例: user1:pass1:email1@example.com:epass1;user2:pass2:email2@example.com:epass2
TWITTER_ACCOUNTS=

# Twitter/X Playwright 登录态 Cookie 文件路径（JSON 格式，需包含 auth_token 和 ct0）
TWITTER_COOKIES_PATH=

# Twitter/X 批量采集批次间延迟秒数（默认 2.0）
TWITTER_BATCH_DELAY=2.0

# Twitter/X 代理配置（twscrape 需要显式代理才能访问 X 平台，国内环境必填）
# 优先读取 TWITTER_PROXY，未设置时自动回退到 HTTPS_PROXY / HTTP_PROXY
# 示例: http://127.0.0.1:7890 或 socks5://127.0.0.1:7890
TWITTER_PROXY=

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/trendpulse

# Token成本控制
TOKEN_WARNING_THRESHOLD=100000

# 采集批次大小（大规模采集时每批写入数据库的条数）
COLLECTION_BATCH_SIZE=500
